{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jmfontaine/copyofa/main/src/copyofa/schemas/comparison-report-5.schema.json",
  "title": "CopyOfA comparison Report, format version 5",
  "description": "The Report that `copyofa compare --json` prints: measurements of how the audio of two preserved tracks relates. See docs/formats/comparison-report.md.",
  "type": "object",
  "properties": {
    "report_kind": { "const": "copyofa.comparison" },
    "format_version": { "const": 5 },
    "copyofa_version": { "type": "string" },
    "compared_at": { "$ref": "#/$defs/timestamp" },
    "omitted": {
      "type": "array",
      "items": {
        "enum": ["/inputs/a/evidence_set", "/inputs/b/evidence_set"]
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "properties": {
        "a": { "$ref": "#/$defs/input" },
        "b": { "$ref": "#/$defs/input" }
      },
      "required": ["a", "b"],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "decoder": { "const": "libsndfile" },
        "decoder_version": { "type": "string" },
        "resampler": { "const": "libsoxr" },
        "resampler_version": { "type": "string" },
        "resampler_quality": { "const": "VHQ" },
        "common_sample_rate": { "type": "integer", "minimum": 1 },
        "alignment": { "const": "windowed_portions" },
        "parameters": { "$ref": "#/$defs/parameters" }
      },
      "required": [
        "decoder",
        "decoder_version",
        "resampler",
        "resampler_version",
        "resampler_quality",
        "alignment",
        "parameters"
      ],
      "additionalProperties": false
    },
    "measurements": { "$ref": "#/$defs/measurements" },
    "limitations": { "$ref": "#/$defs/sentences" }
  },
  "required": [
    "report_kind",
    "format_version",
    "copyofa_version",
    "compared_at",
    "omitted",
    "inputs",
    "method",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "omitted": {
            "type": "array",
            "contains": { "const": "/inputs/a/evidence_set" }
          }
        },
        "required": ["omitted"]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "a": { "type": "object", "properties": { "evidence_set": false } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "a": { "type": "object", "required": ["evidence_set"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "omitted": {
            "type": "array",
            "contains": { "const": "/inputs/b/evidence_set" }
          }
        },
        "required": ["omitted"]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "b": { "type": "object", "properties": { "evidence_set": false } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": {
              "b": { "type": "object", "required": ["evidence_set"] }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "sentences": {
      "type": "array",
      "items": { "type": "string" }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "audio_digest": {
      "type": "string",
      "pattern": "^pcm1:[1-9][0-9]*:[1-9][0-9]*:(8|16|24|32):[0-9a-f]{64}$",
      "not": { "pattern": "\\n" }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "minLength": 20,
      "maxLength": 20
    },
    "integrity_baseline": {
      "type": "object",
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/digest" },
        "usable": { "type": "boolean" },
        "problems": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["usable", "problems"],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "first_frame": { "$ref": "#/$defs/count" },
        "frame_count": { "type": "integer", "minimum": 1 },
        "error_ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/error_range" }
        }
      },
      "required": ["number"],
      "dependentRequired": {
        "first_frame": ["frame_count"],
        "frame_count": ["first_frame"]
      },
      "additionalProperties": false
    },
    "error_range": {
      "type": "object",
      "properties": {
        "offset_frames": { "$ref": "#/$defs/count" },
        "frame_count": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["not_read", "c2_error"] }
      },
      "required": ["offset_frames", "frame_count", "state"],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "evidence_set": { "type": "string" },
        "integrity_baseline": { "$ref": "#/$defs/integrity_baseline" },
        "path": { "type": "string" },
        "track": { "$ref": "#/$defs/track" },
        "outcome": {
          "enum": ["interpreted", "not_interpreted", "failed", "not_inspected"]
        },
        "expected_digest": { "$ref": "#/$defs/digest" },
        "observed_digest": { "$ref": "#/$defs/digest" },
        "reason": { "type": "string" },
        "format": { "enum": ["flac", "wav", "mp3"] },
        "encoding": {
          "enum": [
            "pcm_s8",
            "pcm_u8",
            "pcm_16",
            "pcm_24",
            "pcm_32",
            "mpeg_layer_iii"
          ]
        },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "bits_per_sample": { "type": "integer", "enum": [8, 16, 24, 32] },
        "frames": { "$ref": "#/$defs/count" },
        "audio_digest": { "$ref": "#/$defs/audio_digest" },
        "peak": {
          "type": "array",
          "items": { "type": "number" }
        },
        "leading_silence_frames": { "$ref": "#/$defs/count" },
        "trailing_silence_frames": { "$ref": "#/$defs/count" },
        "flac_md5_signature": { "enum": ["matching", "differs", "absent"] },
        "limitations": { "$ref": "#/$defs/sentences" }
      },
      "required": ["integrity_baseline", "outcome"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "not": { "required": ["track"] } },
          "then": { "required": ["path"] }
        },
        {
          "if": { "not": { "required": ["path"] } },
          "then": {
            "properties": { "expected_digest": false, "observed_digest": false }
          }
        },
        {
          "if": { "required": ["track"] },
          "then": {
            "properties": {
              "outcome": { "enum": ["interpreted", "failed", "not_inspected"] },
              "flac_md5_signature": false
            }
          }
        },
        {
          "if": { "required": ["track", "path"] },
          "then": { "required": ["expected_digest"] }
        },
        {
          "if": {
            "properties": { "outcome": { "enum": ["interpreted", "failed"] } },
            "required": ["track", "outcome"]
          },
          "then": {
            "properties": {
              "track": { "required": ["first_frame", "frame_count"] }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "interpreted" } },
            "required": ["track", "outcome"]
          },
          "then": {
            "properties": {
              "format": { "const": "flac" },
              "encoding": { "const": "pcm_16" },
              "sample_rate": { "const": 44100 },
              "channels": { "const": 2 },
              "bits_per_sample": { "const": 16 }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "interpreted" } },
            "required": ["outcome"]
          },
          "then": {
            "required": [
              "expected_digest",
              "observed_digest",
              "format",
              "encoding",
              "sample_rate",
              "channels",
              "frames",
              "peak",
              "leading_silence_frames",
              "trailing_silence_frames"
            ],
            "properties": { "reason": false }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "enum": ["not_interpreted", "failed"] } },
            "required": ["outcome"]
          },
          "then": {
            "required": ["expected_digest", "observed_digest", "reason"],
            "propertyNames": {
              "enum": [
                "evidence_set",
                "integrity_baseline",
                "path",
                "track",
                "outcome",
                "expected_digest",
                "observed_digest",
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "not_inspected" } },
            "required": ["outcome"]
          },
          "then": {
            "required": ["reason"],
            "propertyNames": {
              "enum": [
                "evidence_set",
                "integrity_baseline",
                "path",
                "track",
                "outcome",
                "expected_digest",
                "observed_digest",
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "format": { "enum": ["flac", "wav"] } },
            "required": ["format"]
          },
          "then": { "required": ["bits_per_sample", "audio_digest"] }
        },
        {
          "if": {
            "properties": { "format": { "const": "mp3" } },
            "required": ["format"]
          },
          "then": {
            "required": ["limitations"],
            "properties": {
              "bits_per_sample": false,
              "audio_digest": false,
              "flac_md5_signature": false
            }
          }
        }
      ]
    },
    "parameters": {
      "type": "object",
      "properties": {
        "decimation_factor": { "const": 16 },
        "decimation_quality": { "const": "HQ" },
        "first_difference_coefficient": { "const": 0.5 },
        "window_seconds": { "const": 5 },
        "hop_seconds": { "const": 5 },
        "silent_window_energy_ratio": { "const": 0.0001 },
        "b_position_energy_floor": { "const": 1e-10 },
        "candidate_threshold": { "const": 0.4 },
        "candidates_per_window": { "const": 3 },
        "candidate_separation_seconds": { "const": 0.5 },
        "skipped_windows": { "const": 1 },
        "chaining_tolerance_frames": { "const": 32 },
        "core_ratio": { "const": 0.85 },
        "core_seconds": { "const": 20 },
        "refinement_radius_frames": { "const": 32 },
        "block_frames": { "const": 2048 },
        "matched_block_residual_ratio": { "const": 0.2 },
        "core_confirming_ratio": { "const": 0.5 },
        "evidence_floor_dbfs": { "const": -80 },
        "silence_against_signal_dbfs": { "const": -60 },
        "end_range_inside_blocks": { "const": 8 },
        "end_range_outside_blocks": { "const": 1 },
        "acceptance_residual_db": { "const": -10 },
        "minimum_portion_seconds": { "const": 1 },
        "merge_tolerance_frames": { "const": 2 },
        "alternate_margin_db": { "const": 3 },
        "alternate_coverage_ratio": { "const": 0.9 },
        "equal_residual_floor_db": { "const": -60 }
      },
      "required": [
        "decimation_factor",
        "decimation_quality",
        "first_difference_coefficient",
        "window_seconds",
        "hop_seconds",
        "silent_window_energy_ratio",
        "b_position_energy_floor",
        "candidate_threshold",
        "candidates_per_window",
        "candidate_separation_seconds",
        "skipped_windows",
        "chaining_tolerance_frames",
        "core_ratio",
        "core_seconds",
        "refinement_radius_frames",
        "block_frames",
        "matched_block_residual_ratio",
        "core_confirming_ratio",
        "evidence_floor_dbfs",
        "silence_against_signal_dbfs",
        "end_range_inside_blocks",
        "end_range_outside_blocks",
        "acceptance_residual_db",
        "minimum_portion_seconds",
        "merge_tolerance_frames",
        "alternate_margin_db",
        "alternate_coverage_ratio",
        "equal_residual_floor_db"
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "properties": {
        "identical_audio": { "const": true },
        "portions": {
          "type": "array",
          "items": { "$ref": "#/$defs/portion" }
        },
        "unmatched": {
          "type": "object",
          "properties": {
            "a": { "$ref": "#/$defs/unmatched" },
            "b": { "$ref": "#/$defs/unmatched" }
          },
          "required": ["a", "b"],
          "additionalProperties": false
        },
        "absent": {
          "type": "object",
          "properties": {
            "portions": { "type": "string" }
          },
          "required": ["portions"],
          "additionalProperties": false
        }
      },
      "required": ["portions", "unmatched"],
      "additionalProperties": false,
      "if": { "required": ["absent"] },
      "then": { "properties": { "portions": { "maxItems": 0 } } },
      "else": { "properties": { "portions": { "minItems": 1 } } }
    },
    "range": {
      "type": "object",
      "properties": {
        "start_frame": { "$ref": "#/$defs/count" },
        "frames": { "type": "integer", "minimum": 1 }
      },
      "required": ["start_frame", "frames"],
      "additionalProperties": false
    },
    "portion": {
      "type": "object",
      "properties": {
        "rank": { "enum": ["primary", "alternate"] },
        "a": { "$ref": "#/$defs/range" },
        "b": { "$ref": "#/$defs/range" },
        "offset": {
          "type": "object",
          "properties": {
            "frames": { "type": "integer" },
            "seconds": { "type": "number" }
          },
          "required": ["frames", "seconds"],
          "additionalProperties": false
        },
        "block_gain_residual_db": { "type": "number" },
        "downmix": { "$ref": "#/$defs/values" },
        "channels": {
          "type": "array",
          "items": { "$ref": "#/$defs/values" }
        },
        "absent": {
          "type": "object",
          "properties": {
            "block_gain_residual_db": { "type": "string" },
            "channels": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "required": ["rank", "a", "b", "offset", "downmix"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "required": ["absent"],
              "properties": {
                "absent": {
                  "type": "object",
                  "required": ["block_gain_residual_db"]
                }
              }
            }
          },
          "then": { "required": ["block_gain_residual_db"] }
        },
        {
          "if": {
            "not": {
              "required": ["absent"],
              "properties": {
                "absent": { "type": "object", "required": ["channels"] }
              }
            }
          },
          "then": { "required": ["channels"] }
        }
      ]
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_frame": { "$ref": "#/$defs/count" },
          "frames": { "type": "integer", "minimum": 1 },
          "digitally_silent": { "type": "boolean" },
          "level_dbfs": { "type": "number" }
        },
        "required": ["start_frame", "frames", "digitally_silent"],
        "additionalProperties": false,
        "if": { "properties": { "digitally_silent": { "const": false } } },
        "then": { "required": ["level_dbfs"] },
        "else": { "properties": { "level_dbfs": false } }
      }
    },
    "values": {
      "type": "object",
      "properties": {
        "correlation": { "type": "number", "minimum": -1, "maximum": 1 },
        "gain_db": { "type": "number" },
        "residual_db": { "type": "number" },
        "residual_windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/window" }
        },
        "absent": {
          "type": "object",
          "properties": {
            "correlation": { "type": "string" },
            "gain_db": { "type": "string" },
            "residual_db": { "type": "string" },
            "residual_windows": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "required": ["absent"],
              "properties": {
                "absent": { "type": "object", "required": ["correlation"] }
              }
            }
          },
          "then": { "required": ["correlation"] }
        },
        {
          "if": {
            "not": {
              "required": ["absent"],
              "properties": {
                "absent": { "type": "object", "required": ["gain_db"] }
              }
            }
          },
          "then": { "required": ["gain_db"] }
        },
        {
          "if": {
            "not": {
              "required": ["absent"],
              "properties": {
                "absent": { "type": "object", "required": ["residual_db"] }
              }
            }
          },
          "then": { "required": ["residual_db"] }
        },
        {
          "if": {
            "not": {
              "required": ["absent"],
              "properties": {
                "absent": { "type": "object", "required": ["residual_windows"] }
              }
            }
          },
          "then": { "required": ["residual_windows"] }
        }
      ]
    },
    "window": {
      "type": "object",
      "properties": {
        "start_frame": { "$ref": "#/$defs/count" },
        "frames": { "$ref": "#/$defs/count" },
        "residual_db": { "type": "number" },
        "absent": {
          "type": "object",
          "properties": { "residual_db": { "type": "string" } },
          "required": ["residual_db"],
          "additionalProperties": false
        }
      },
      "required": ["start_frame", "frames"],
      "additionalProperties": false,
      "if": { "not": { "required": ["absent"] } },
      "then": { "required": ["residual_db"] }
    }
  }
}
